.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Local datasets and preprocessing work products. These are downloaded or
# regenerated by the scripts in this repository and are too large for Git.
data/*
!data/.gitkeep
build/

# Credentials and locally issued software licences must never be committed.
licenses/
license.txt
*.license
.env
.env.*

# Generated outputs
results/*
!results/.gitkeep
figures/*
!figures/.gitkeep

# Local review intermediates
tmp/

# External research code is tracked by URL and commit in the provenance file.
upstream/*/

# Editor-local state (the shared interpreter recommendation is safe to track).
.vscode/*
!.vscode/settings.json
