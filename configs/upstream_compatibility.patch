+// Paired counterfactual simulation with identical post-burn-in state and noise.
+static PyObject* hopf_simulate_paired_perturbation(PyObject* self, PyObject* args) {
+    PyObject *GEC_py, *frequencies_py, *mask_py;
+    int pre_samples, pulse_samples, recovery_samples, noise_type;
+    unsigned int random_seed;
+    double TR, sigma, a, delta_a, burnin_seconds;
+    if (!PyArg_ParseTuple(args, "OOOiiidddddiI", &GEC_py, &frequencies_py, &mask_py,
+                          &pre_samples, &pulse_samples, &recovery_samples, &TR, &sigma,
+                          &a, &delta_a, &burnin_seconds, &noise_type, &random_seed)) {
+        PyErr_SetString(PyExc_TypeError, "Expected GEC, frequencies, mask, pre_samples, pulse_samples, recovery_samples, TR, sigma, a, delta_a, burnin_seconds, noise_type, seed");
+        return NULL;
+    }
+    PyArrayObject* GEC_array = (PyArrayObject*)PyArray_FROM_OTF(GEC_py, NPY_DOUBLE, NPY_ARRAY_IN_ARRAY);
+    PyArrayObject* freq_array = (PyArrayObject*)PyArray_FROM_OTF(frequencies_py, NPY_DOUBLE, NPY_ARRAY_IN_ARRAY);
+    PyArrayObject* mask_array = (PyArrayObject*)PyArray_FROM_OTF(mask_py, NPY_DOUBLE, NPY_ARRAY_IN_ARRAY);
+    if (!GEC_array || !freq_array || !mask_array) {
+        Py_XDECREF(GEC_array); Py_XDECREF(freq_array); Py_XDECREF(mask_array);
+        return NULL;
+    }
+    try {
+        Eigen::MatrixXd GEC = numpy_to_eigen_matrix(GEC_array);
+        Eigen::VectorXd frequencies = numpy_to_eigen_vector(freq_array);
+        Eigen::VectorXd mask = numpy_to_eigen_vector(mask_array);
+        const int N = GEC.rows();
+        if (GEC.cols() != N || frequencies.size() != N || mask.size() != N) {
+            throw std::runtime_error("Paired perturbation dimensions do not match");
+        }
+        HopfConfig config;
+        config.N=N; config.T=pre_samples+pulse_samples+recovery_samples;
+        config.TR=TR; config.sigma=sigma; config.a=a;
+        config.noise=static_cast<HopfConfig::Noise>(noise_type);
+        config.random_seed=random_seed; config.burnin_steps=static_cast<int>(burnin_seconds);
+        config.gec_matrix=GEC; config.regional_frequencies=frequencies;
+        HopfSimulator burned(config);
+        burned.burn_in_only();
+        HopfSimulator control = burned;
+        HopfSimulator intervention = burned;
+        Eigen::VectorXd zero = Eigen::VectorXd::Zero(N);
+        Eigen::VectorXd shift = delta_a * mask;
+        Eigen::MatrixXd control_all(N, config.T), intervention_all(N, config.T);
+        int offset=0;
+        for (int segment=0; segment<3; ++segment) {
+            int count = segment==0 ? pre_samples : (segment==1 ? pulse_samples : recovery_samples);
+            Eigen::MatrixXd c = control.simulate_segment(count, zero);
+            Eigen::MatrixXd i = intervention.simulate_segment(count, segment==1 ? shift : zero);
+            control_all.middleCols(offset,count)=c;
+            intervention_all.middleCols(offset,count)=i;
+            offset += count;
+        }
+        Py_DECREF(GEC_array); Py_DECREF(freq_array); Py_DECREF(mask_array);
+        PyObject* result=PyTuple_New(2);
+        PyTuple_SetItem(result,0,eigen_matrix_to_numpy(control_all));
+        PyTuple_SetItem(result,1,eigen_matrix_to_numpy(intervention_all));
+        return result;
+    } catch (const std::exception& e) {
+        Py_DECREF(GEC_array); Py_DECREF(freq_array); Py_DECREF(mask_array);
+        PyErr_SetString(PyExc_RuntimeError,e.what()); return NULL;
+    }
+}
